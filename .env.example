# LeadGuard OS V6 — Environment Configuration Template
# Copy this file to .env and configure for your local/staging/production deployment.

# ==============================================================================
# Environment & Server Settings
# ==============================================================================
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:5173
API_URL=http://localhost:4000
COOKIE_DOMAIN=localhost
CORS_ORIGINS=http://localhost:5173

# ==============================================================================
# Primary Database (PostgreSQL)
# ==============================================================================
DATABASE_URL=postgresql://leadguard:leadguard@localhost:15432/leadguard

# ==============================================================================
# Cache & Queues (Redis)
# ==============================================================================
REDIS_URL=redis://localhost:16380

# ==============================================================================
# Security & Cryptography Keys (Min 32 characters random strings)
# ==============================================================================
JWT_SECRET=replace-with-a-long-random-secret-key-at-least-32-characters
REFRESH_TOKEN_SECRET=replace-with-another-random-secret-key-at-least-32-characters
# 64-char hex (32-byte) key used to encrypt webhook HMAC secrets at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WEBHOOK_SECRET_ENCRYPTION_KEY=replace-with-a-64-character-hex-string-32-bytes-0000000000000000

# ==============================================================================
# Commercial Billing (Razorpay)
# ==============================================================================
# PAYMENT_PROVIDER_MODE:
#   TEST (default) - uses rzp_test_* keys
#   LIVE           - requires rzp_live_* keys; never falls back to TEST
# The provider refuses to start unless the key prefix matches the selected mode.
PAYMENT_PROVIDER_MODE=TEST
RAZORPAY_KEY_ID=rzp_test_replace_with_your_key_id
RAZORPAY_KEY_SECRET=replace_with_your_key_secret
RAZORPAY_WEBHOOK_SECRET=replace_with_your_webhook_secret

# ==============================================================================
# Reverse Proxy / Trusted Client IP
# ==============================================================================
# Set to true ONLY when running behind a trusted reverse proxy that sets a
# clean X-Forwarded-For header. When false (default), X-Forwarded-For is ignored
# and the socket address is used for rate limiting, preventing header spoofing.
TRUST_PROXY=false

# ==============================================================================
# AI Provider Integration (pitch generation)
# ==============================================================================
# AI_PROVIDER=GEMINI requires GEMINI_API_KEY to be set (enforced at boot).
AI_PROVIDER=MOCK
GEMINI_API_KEY=

# ==============================================================================
# Email Dispatcher
# ==============================================================================
# EMAIL_PROVIDER=SMTP requires SMTP_HOST/SMTP_USER/SMTP_PASS to be set (enforced at boot).
EMAIL_PROVIDER=MOCK
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="LeadGuard Intelligence <alerts@leadguard.io>"

# ==============================================================================
# Report & Asset Storage
# ==============================================================================
# REPORT_STORAGE=S3 requires S3_ACCESS_KEY_ID/S3_SECRET_ACCESS_KEY (enforced at boot).
REPORT_STORAGE=LOCAL
S3_BUCKET=leadguard-reports
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ==============================================================================
# Audit Crawling
# ==============================================================================
# Re-scans the homepage with a headless browser and merges any additional
# tracking/CTA signals found (JS-rendered content the plain-fetch crawler
# can't see) — never used to remove a finding the static scan already made.
ENABLE_JS_RENDERED_RESCAN=true
