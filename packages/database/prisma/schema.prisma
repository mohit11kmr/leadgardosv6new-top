generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMIN
  MEMBER
  VIEWER
  AGENCY_ADMIN
  AGENCY_MEMBER
}

enum AuditStatus {
  QUEUED
  RUNNING
  COMPLETED
  PARTIAL
  FAILED
  CANCELLED
}

enum Severity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
  INFO
}

enum FindingScope {
  PAGE
  WEBSITE
  AUDIT
}

enum SubscriptionStatus {
  CREATED
  TRIALING
  ACTIVE
  PAST_DUE
  PAUSED
  CANCELLED
  EXPIRED
  FAILED
}

enum PaymentStatus {
  CREATED
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentPurpose {
  SUBSCRIPTION
  EXPRESS_FIX
  WATCHDOG
  PLAN_UPGRADE
}

enum ExpressFixStatus {
  ORDER_CREATED
  PAYMENT_PENDING
  PAID
  FULFILLMENT_PENDING
  FULFILLMENT_IN_PROGRESS
  FULFILLED
  FULFILLMENT_FAILED
}

enum InvoiceStatus {
  DRAFT
  OPEN
  PAID
  VOID
  UNCOLLECTIBLE
}

enum BillingInterval {
  MONTHLY
  YEARLY
  ONE_TIME
}

enum UsageMetric {
  AUDITS
  WEBSITES
  API_REQUESTS
  MONITORING
}

enum MonitoringFrequency {
  FIVE_MINUTES
  FIFTEEN_MINUTES
  HOURLY
  DAILY
}

enum MonitoringStatus {
  QUEUED
  RUNNING
  COMPLETED
  PARTIAL
  FAILED
  SKIPPED
}

enum FindingChangeType {
  NEW
  RESOLVED
  PERSISTING
  REGRESSED
  UNCHANGED
}

enum AlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
  SUPPRESSED
}

model User {
  id                      String                   @id @default(uuid())
  email                   String                   @unique
  name                    String?
  passwordHash            String
  timezone                String?                  @default("UTC")
  locale                  String?                  @default("en")
  isDisabled              Boolean                  @default(false)
  disabledReason          String?
  emailVerifiedAt         DateTime?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  memberships             OrganizationMember[]
  sessions                Session[]
  accounts                Account[]
  securityEvents          SecurityEvent[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  clientWorkspaceMembers  ClientWorkspaceMember[]
  adminAuditLogs          AdminAuditLog[]
  notificationPreferences NotificationPreference[]
}

model Account {
  id                String @id @default(uuid())
  userId            String
  provider          String
  providerAccountId String
  user              User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id                  String    @id @default(uuid())
  userId              String
  refreshTokenHash    String    @unique
  replacedByTokenHash String?
  expiresAt           DateTime
  revokedAt           DateTime?
  lastSeenAt          DateTime  @default(now())
  ipAddress           String?
  userAgent           String?
  createdAt           DateTime  @default(now())
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([userId, expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model SecurityEvent {
  id        String   @id @default(uuid())
  userId    String?
  type      String
  ipAddress String?
  metadata  Json?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([type, createdAt])
}

model Organization {
  id                    String                 @id @default(uuid())
  name                  String
  slug                  String                 @unique
  isSuspended           Boolean                @default(false)
  suspendedReason       String?
  deletedAt             DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  members               OrganizationMember[]
  websites              Website[]
  audits                Audit[]
  subscriptions         Subscription[]
  payments              Payment[]
  invoices              Invoice[]
  billingEvents         BillingEvent[]
  usageRecords          UsageRecord[]
  apiKeys               ApiKey[]
  apiUsages             ApiUsage[]
  webhooks              WebhookEndpoint[]
  webhookDeliveries     WebhookDelivery[]
  outboxEvents          OutboxEvent[]
  reports               Report[]
  monitoringConfigs     MonitoringConfig[]
  monitoringRuns        MonitoringRun[]
  monitoringAlerts      MonitoringAlert[]
  testimonials          Testimonial[]
  clientWorkspaces      ClientWorkspace[]
  prospectCampaigns     ProspectCampaign[]
  prospects             Prospect[]
  pitches               Pitch[]
  widgets               Widget[]
  competitorComparisons CompetitorComparison[]
  pitchGenerations      PitchGeneration[]
  notificationPreferences NotificationPreference[]
  expressFixFulfillments ExpressFixFulfillment[]
}

model OrganizationMember {
  organizationId String
  userId         String
  role           Role
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([organizationId, userId])
  @@index([userId])
}

model Website {
  id                String            @id @default(uuid())
  organizationId    String
  clientWorkspaceId String?
  url               String
  normalizedUrl     String
  domain            String
  name              String
  status            String            @default("ACTIVE")
  deletedAt         DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  organization      Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientWorkspace   ClientWorkspace?  @relation(fields: [clientWorkspaceId], references: [id], onDelete: SetNull)
  domains           WebsiteDomain[]
  settings          WebsiteSettings?
  audits            Audit[]
  monitoringConfig  MonitoringConfig?
  expressFixFulfillments ExpressFixFulfillment[]

  @@unique([organizationId, url])
  @@index([organizationId, deletedAt])
  @@index([clientWorkspaceId])
}

model WebsiteDomain {
  id         String    @id @default(uuid())
  websiteId  String
  hostname   String
  verifiedAt DateTime?
  website    Website   @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@unique([websiteId, hostname])
}

model WebsiteSettings {
  websiteId String  @id
  settings  Json
  website   Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)
}

model Audit {
  id                String         @id @default(uuid())
  organizationId    String
  websiteId         String
  status            AuditStatus    @default(QUEUED)
  progress          Int            @default(0)
  progressStage     String         @default("queued")
  idempotencyKey    String?
  scoringVersion    String         @default("v3")
  queuedAt          DateTime       @default(now())
  startedAt         DateTime?
  completedAt       DateTime?
  durationMs        Int?
  pagesDiscovered   Int            @default(0)
  pagesFetched      Int            @default(0)
  pagesScanned      Int            @default(0)
  findingsGenerated Int            @default(0)
  businessImpact    Json?
  executiveSummary  Json?
  telemetry         Json?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  organization      Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  website           Website        @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  runs              AuditRun[]
  pages             AuditPage[]
  findings          AuditFinding[]
  score             AuditScore?
  reports           Report[]
  prospects         Prospect[]
  expressFixFulfillments ExpressFixFulfillment[]

  @@index([organizationId, createdAt])
  @@index([websiteId, status])
  @@unique([organizationId, idempotencyKey])
}

model AuditPage {
  id             String   @id @default(uuid())
  auditId        String
  url            String
  finalUrl       String
  statusCode     Int?
  title          String?
  contentType    String?
  headers        Json?
  htmlAvailable  Boolean  @default(false)
  responseTimeMs Int?
  depth          Int
  parentUrl      String?
  errorCode      String?
  redirectChain  Json?
  createdAt      DateTime @default(now())
  audit          Audit    @relation(fields: [auditId], references: [id], onDelete: Cascade)

  @@unique([auditId, url])
  @@index([auditId, depth])
}

model AuditRun {
  id            String      @id @default(uuid())
  auditId       String
  status        AuditStatus @default(QUEUED)
  pagesFetched  Int         @default(0)
  findingsCount Int         @default(0)
  durationMs    Int?
  errorCode     String?
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime    @default(now())
  audit         Audit       @relation(fields: [auditId], references: [id], onDelete: Cascade)

  @@index([auditId, createdAt])
}

model AuditFinding {
  id                 String       @id @default(uuid())
  auditId            String
  ruleId             String
  internalKey        String?
  normalizedIssueKey String?
  category           String
  scope              FindingScope @default(PAGE)
  severity           Severity
  title              String
  description        String
  evidence           Json
  affectedUrl        String?
  recommendation     String
  scoreImpact        Int
  businessImpact     String?
  metadata           Json?
  audit              Audit        @relation(fields: [auditId], references: [id], onDelete: Cascade)

  @@index([auditId, severity])
  @@index([auditId, scope])
  @@index([auditId, category])
  @@index([auditId, normalizedIssueKey])
}

model AuditScore {
  auditId     String @id
  lead        Int
  advertising Int
  seo         Int
  security    Int
  overall     Int
  audit       Audit  @relation(fields: [auditId], references: [id], onDelete: Cascade)
}

model Report {
  id              String            @id @default(uuid())
  organizationId  String
  auditId         String
  title           String            @default("LeadGuard Diagnostic Audit Report")
  version         Int               @default(1)
  reportVersion   String            @default("v1")
  templateVersion String            @default("v1")
  brandingVersion String            @default("v1")
  status          String            @default("READY") // READY, ARCHIVED
  snapshotData    Json?
  pdfPath         String?
  pdfStatus       String            @default("NONE") // NONE, QUEUED, GENERATING, READY, FAILED
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @default(now()) @updatedAt
  organization    Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  audit           Audit             @relation(fields: [auditId], references: [id], onDelete: Cascade)
  versions        ReportVersion[]
  shareLinks      ReportShareLink[]

  @@index([organizationId, createdAt])
  @@index([auditId])
}

model ReportVersion {
  id       String @id @default(uuid())
  reportId String
  version  Int
  content  Json
  report   Report @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@unique([reportId, version])
}

model ReportShareLink {
  id             String    @id @default(uuid())
  reportId       String
  tokenHash      String    @unique
  passwordHash   String?
  accessCount    Int       @default(0)
  lastAccessedAt DateTime?
  expiresAt      DateTime?
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())
  report         Report    @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId, revokedAt])
}

model MonitoringConfig {
  id                      String              @id @default(uuid())
  organizationId          String
  websiteId               String              @unique
  enabled                 Boolean             @default(true)
  frequency               MonitoringFrequency @default(HOURLY)
  maxPages                Int                 @default(10)
  maxDepth                Int                 @default(2)
  consecutiveFailures     Int                 @default(0)
  failureThreshold        Int                 @default(2)
  responseTimeThresholdMs Int                 @default(3000)
  tlsExpiryThresholdDays  Int                 @default(14)
  lockedUntil             DateTime?
  lockToken               String?
  healthChecks            Json?
  alertPolicy             Json?
  baseline                Json?
  baselineVersion         Int                 @default(1)
  lastRunAt               DateTime?
  nextRunAt               DateTime?
  archivedAt              DateTime?
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt
  organization            Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  website                 Website             @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  runs                    MonitoringRun[]
  findings                MonitoringFinding[]
  alerts                  MonitoringAlert[]

  @@index([organizationId, enabled, archivedAt])
  @@index([enabled, nextRunAt])
}

model MonitoringRun {
  id                  String            @id @default(uuid())
  monitoringConfigId  String
  websiteId           String
  organizationId      String
  scheduledSlot       String?
  idempotencyKey      String?
  status              MonitoringStatus  @default(QUEUED)
  httpStatus          Int?
  responseTimeMs      Int?
  tlsValid            Boolean?
  tlsExpiresAt        DateTime?
  redirectChain       Json?
  scores              Json?
  scoreDeltas         Json?
  pagesEvaluated      Int               @default(1)
  findingsCount       Int               @default(0)
  newRegressionsCount Int               @default(0)
  resolvedCount       Int               @default(0)
  telemetry           Json?
  errorCode           String?
  scheduledAt         DateTime?
  startedAt           DateTime?
  completedAt         DateTime?
  durationMs          Int?
  createdAt           DateTime          @default(now())
  config              MonitoringConfig  @relation(fields: [monitoringConfigId], references: [id], onDelete: Cascade)
  organization        Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  findings            MonitoringFinding[]
  alerts              MonitoringAlert[]

  @@unique([monitoringConfigId, scheduledSlot])
  @@index([monitoringConfigId, createdAt])
  @@index([organizationId, createdAt])
}

model MonitoringFinding {
  id                 String            @id @default(uuid())
  monitoringRunId    String
  monitoringConfigId String
  websiteId          String
  organizationId     String
  ruleId             String
  category           String
  severity           Severity
  changeType         FindingChangeType
  title              String
  description        String
  affectedUrl        String?
  pageTitle          String?
  beforeState        Json?
  afterState         Json?
  evidence           Json?
  detectedAt         DateTime          @default(now())
  run                MonitoringRun     @relation(fields: [monitoringRunId], references: [id], onDelete: Cascade)
  config             MonitoringConfig  @relation(fields: [monitoringConfigId], references: [id], onDelete: Cascade)

  @@index([monitoringConfigId, detectedAt])
  @@index([monitoringConfigId, affectedUrl])
  @@index([monitoringRunId, changeType])
}

model MonitoringAlert {
  id                 String            @id @default(uuid())
  organizationId     String
  monitoringConfigId String?
  monitoringRunId    String?
  websiteId          String?
  fingerprint        String
  ruleId             String?
  severity           Severity          @default(HIGH)
  title              String
  message            String
  status             AlertStatus       @default(OPEN)
  lastAlertedAt      DateTime          @default(now())
  cooldownUntil      DateTime?
  acknowledgedAt     DateTime?
  resolvedAt         DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  organization       Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  config             MonitoringConfig? @relation(fields: [monitoringConfigId], references: [id], onDelete: Cascade)
  run                MonitoringRun?    @relation(fields: [monitoringRunId], references: [id], onDelete: SetNull)

  @@unique([monitoringConfigId, fingerprint, status])
  @@index([organizationId, status])
  @@index([monitoringConfigId, fingerprint])
}

model Plan {
  id              String          @id @default(uuid())
  code            String          @unique
  name            String
  description     String?
  priceInPaise    Int             @default(0)
  currency        String          @default("INR")
  billingInterval BillingInterval @default(MONTHLY)
  entitlements    Json
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  subscriptions   Subscription[]
}

model Subscription {
  id                     String             @id @default(uuid())
  organizationId         String
  planId                 String
  status                 SubscriptionStatus @default(ACTIVE)
  provider               String             @default("RAZORPAY")
  providerSubscriptionId String?            @unique
  providerCustomerId     String?
  currentPeriodStart     DateTime           @default(now())
  currentPeriodEnd       DateTime?
  cancelAtPeriodEnd      Boolean            @default(false)
  canceledAt             DateTime?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  organization           Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan                   Plan               @relation(fields: [planId], references: [id])
  payments               Payment[]

  @@index([organizationId, status])
}

model Payment {
  id                String         @id @default(uuid())
  organizationId    String
  subscriptionId    String?
  provider          String         @default("RAZORPAY")
  providerPaymentId String         @unique
  providerOrderId   String?
  providerSignature String?
  amountInPaise     Int
  currency          String         @default("INR")
  status            PaymentStatus  @default(CAPTURED)
  purpose           PaymentPurpose @default(SUBSCRIPTION)
  metadata          Json?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  organization      Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subscription      Subscription?  @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  invoices          Invoice[]
  expressFixFulfillment ExpressFixFulfillment?

  @@index([organizationId, createdAt])
}

model Invoice {
  id             String        @id @default(uuid())
  organizationId String
  paymentId      String?
  invoiceNumber  String        @unique
  amountInPaise  Int
  currency       String        @default("INR")
  status         InvoiceStatus @default(PAID)
  billingAddress Json?
  taxInfo        Json?
  pdfUrl         String?
  paidAt         DateTime?
  createdAt      DateTime      @default(now())
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  payment        Payment?      @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
}

model ExpressFixFulfillment {
  id             String            @id @default(uuid())
  organizationId String
  websiteId      String
  auditId        String?
  paymentId      String            @unique
  status         ExpressFixStatus  @default(ORDER_CREATED)
  notes          String?
  assignedTo     String?
  completedAt    DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  website        Website           @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  audit          Audit?            @relation(fields: [auditId], references: [id], onDelete: SetNull)
  payment        Payment           @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@index([paymentId])
}

model BillingEvent {
  id              String       @id @default(uuid())
  organizationId  String
  provider        String       @default("RAZORPAY")
  providerEventId String?
  type            String
  data            Json?
  createdAt       DateTime     @default(now())
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
}

model UsageRecord {
  id             String       @id @default(uuid())
  organizationId String
  period         String
  metric         UsageMetric
  count          Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, period, metric])
  @@index([organizationId, period])
}

model ApiKey {
  id             String       @id @default(uuid())
  organizationId String
  name           String
  keyPrefix      String?
  keyHash        String       @unique
  scopes         String[]
  expiresAt      DateTime?
  lastUsedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  apiUsages      ApiUsage[]

  @@index([organizationId, revokedAt])
}

model WebhookEndpoint {
  id             String            @id @default(uuid())
  organizationId String
  url            String
  secretHash     String
  events         String[]
  enabled        Boolean           @default(true)
  description    String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deliveries     WebhookDelivery[]

  @@index([organizationId, enabled])
}

model Testimonial {
  id                String           @id @default(uuid())
  organizationId    String
  clientWorkspaceId String?
  authorName        String           @default("Anonymous")
  companyName       String?
  role              String?
  content           String           @default("")
  rating            Int              @default(5)
  status            String           @default("PENDING") // PENDING, APPROVED, REJECTED, ARCHIVED
  publishedAt       DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @default(now()) @updatedAt
  organization      Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientWorkspace   ClientWorkspace? @relation(fields: [clientWorkspaceId], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([status, publishedAt])
}

model ClientWorkspace {
  id                    String                  @id @default(uuid())
  organizationId        String
  name                  String
  slug                  String
  status                String                  @default("ACTIVE") // ACTIVE, ARCHIVED, ONBOARDING
  contactName           String?
  contactEmail          String?
  notes                 String?
  branding              Json?                   // { logoUrl, companyName, website, supportEmail, primaryColor, secondaryColor, footer }
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  archivedAt            DateTime?
  organization          Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  websites              Website[]
  members               ClientWorkspaceMember[]
  widgets               Widget[]
  testimonials          Testimonial[]
  prospectCampaigns     ProspectCampaign[]
  competitorComparisons CompetitorComparison[]

  @@unique([organizationId, slug])
  @@index([organizationId, status, archivedAt])
}

model ClientWorkspaceMember {
  id                String          @id @default(uuid())
  clientWorkspaceId String
  userId            String
  role              String          @default("MEMBER")
  createdAt         DateTime        @default(now())
  workspace         ClientWorkspace @relation(fields: [clientWorkspaceId], references: [id], onDelete: Cascade)
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([clientWorkspaceId, userId])
}

model ProspectCampaign {
  id                String           @id @default(uuid())
  organizationId    String
  clientWorkspaceId String?
  name              String
  source            String           @default("MANUAL") // CSV, MANUAL, SEARCH
  status            String           @default("DRAFT")  // DRAFT, QUEUED, RUNNING, PAUSED, COMPLETED, CANCELLED, FAILED, PARTIAL
  targetCount       Int              @default(0)
  processedCount    Int              @default(0)
  successfulCount   Int              @default(0)
  failedCount       Int              @default(0)
  skippedCount      Int              @default(0)
  qualifiedCount    Int              @default(0)
  qualificationCriteria Json?
  errorMessage      String?
  startedAt         DateTime?
  completedAt       DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  organization      Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientWorkspace   ClientWorkspace? @relation(fields: [clientWorkspaceId], references: [id], onDelete: SetNull)
  prospects         Prospect[]

  @@index([organizationId, status])
  @@index([clientWorkspaceId])
}

model Prospect {
  id                   String            @id @default(uuid())
  campaignId           String
  organizationId       String
  url                  String
  normalizedUrl        String
  domain               String
  businessName         String?
  industry             String?
  location             String?
  status               String            @default("DISCOVERED") // DISCOVERED, VALIDATED, AUDITED, QUALIFIED, CONTACTED, CONVERTED, DISMISSED
  leadScore            Int?
  criticalFindings     Int               @default(0)
  highFindings         Int               @default(0)
  potentialOpportunity String?
  auditId              String?
  audit                Audit?            @relation(fields: [auditId], references: [id], onDelete: SetNull)
  lastCheckedAt        DateTime?
  source               String            @default("MANUAL")
  notes                String?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  campaign             ProspectCampaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  organization         Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  pitches              Pitch[]
  pitchGenerations     PitchGeneration[]

  @@unique([campaignId, normalizedUrl])
  @@index([campaignId, status])
  @@index([organizationId, domain])
}

model Pitch {
  id              String       @id @default(uuid())
  prospectId      String
  organizationId  String
  version         Int          @default(1)
  generationType  String       @default("DETERMINISTIC_TEMPLATE") // DETERMINISTIC_TEMPLATE, REAL_AI
  provider        String       @default("DETERMINISTIC_TEMPLATE")
  model           String       @default("template-v1")
  promptVersion   String       @default("v1")
  language        String       @default("en")
  tone            String       @default("PROFESSIONAL") // PROFESSIONAL, DIRECT, CONSULTATIVE, URGENT
  subject         String
  opening         String
  problem         String
  businessImpact  String
  recommendation  String
  callToAction    String
  content         String
  claimReferences Json?
  idempotencyKey  String?
  tokensUsed      Int?
  estimatedCost   Float?
  createdAt       DateTime     @default(now())
  prospect        Prospect     @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([prospectId, version])
  @@index([prospectId, createdAt])
  @@index([organizationId, createdAt])
}

model PitchGeneration {
  id             String       @id @default(uuid())
  organizationId String
  prospectId     String
  status         String       @default("QUEUED") // QUEUED, RUNNING, COMPLETED, FAILED, CANCELLED
  idempotencyKey String?
  pitchId        String?
  error          String?
  tokensUsed     Int?
  estimatedCost  Float?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  prospect       Prospect     @relation(fields: [prospectId], references: [id], onDelete: Cascade)

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, status])
  @@index([prospectId, createdAt])
}

model Widget {
  id                String           @id @default(uuid())
  organizationId    String
  clientWorkspaceId String?
  name              String
  tokenHash         String           @unique
  allowedOrigins    String[]
  theme             String           @default("LIGHT") // LIGHT, DARK, AUTO
  displayMode       String           @default("EMBED") // EMBED, MODAL, FLOATING_BUTTON
  enabled           Boolean          @default(true)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  organization      Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientWorkspace   ClientWorkspace? @relation(fields: [clientWorkspaceId], references: [id], onDelete: SetNull)

  @@index([organizationId, enabled])
}

model CompetitorComparison {
  id                String           @id @default(uuid())
  organizationId    String
  clientWorkspaceId String?
  name              String
  targetUrl         String
  competitorUrls    String[]
  status            String           @default("DRAFT") // DRAFT, QUEUED, RUNNING, COMPLETED, FAILED
  comparisonData    Json?
  strengths         Json?
  weaknesses        Json?
  opportunities     Json?
  lastRunAt         DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  organization      Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientWorkspace   ClientWorkspace? @relation(fields: [clientWorkspaceId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
}

model ApiUsage {
  id             String       @id @default(uuid())
  organizationId String
  apiKeyId       String?
  endpoint       String
  method         String
  statusCode     Int
  latencyMs      Int
  ipAddress      String?
  timestamp      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  apiKey         ApiKey?      @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)

  @@index([organizationId, timestamp])
  @@index([apiKeyId, timestamp])
}

model WebhookDelivery {
  id                String          @id @default(uuid())
  webhookEndpointId String
  organizationId    String
  event             String
  deliveryId        String          @unique
  payload           Json
  statusCode        Int?
  responseBody      String?
  attempts          Int             @default(1)
  status            String          @default("SUCCESS") // SUCCESS, FAILED, RETRYING
  errorMessage      String?
  deliveredAt       DateTime?
  createdAt         DateTime        @default(now())
  webhookEndpoint   WebhookEndpoint @relation(fields: [webhookEndpointId], references: [id], onDelete: Cascade)
  organization      Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([webhookEndpointId, createdAt])
  @@index([organizationId, createdAt])
}

model OutboxEvent {
  id             String       @id @default(uuid())
  organizationId String
  eventType      String
  aggregateType  String
  aggregateId    String
  payload        Json
  status         String       @default("PENDING") // PENDING, PROCESSING, PUBLISHED, FAILED
  retryCount     Int          @default(0)
  error          String?
  createdAt      DateTime     @default(now())
  processedAt    DateTime?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([organizationId, createdAt])
}

model AdminAuditLog {
  id           String   @id @default(uuid())
  userId       String?
  action       String
  resourceType String
  resourceId   String?
  details      Json?
  ipAddress    String?
  createdAt    DateTime @default(now())
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([resourceType, createdAt])
}

model NotificationPreference {
  id             String       @id @default(uuid())
  userId         String
  organizationId String
  channel        String       @default("EMAIL") // EMAIL, IN_APP
  eventTypes     String[]     @default(["AUDIT_COMPLETED", "MONITORING_ALERT", "BILLING_INVOICE"])
  enabled        Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId, channel])
}

