generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMIN
  MEMBER
  VIEWER
  AGENCY_ADMIN
  AGENCY_MEMBER
}

enum AuditStatus {
  QUEUED
  RUNNING
  COMPLETED
  PARTIAL
  FAILED
  CANCELLED
}

enum Severity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
  INFO
}

enum FindingScope {
  PAGE
  WEBSITE
  AUDIT
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  PAUSED
  CANCELLED
  EXPIRED
}

enum PaymentStatus {
  CREATED
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentPurpose {
  SUBSCRIPTION
  EXPRESS_FIX
  WATCHDOG
  PLAN_UPGRADE
}

enum InvoiceStatus {
  DRAFT
  OPEN
  PAID
  VOID
  UNCOLLECTIBLE
}

enum BillingInterval {
  MONTHLY
  YEARLY
  ONE_TIME
}

enum UsageMetric {
  AUDITS
  WEBSITES
  API_REQUESTS
  MONITORING
}

enum MonitoringFrequency {
  FIVE_MINUTES
  FIFTEEN_MINUTES
  HOURLY
  DAILY
}

enum MonitoringStatus {
  QUEUED
  RUNNING
  COMPLETED
  PARTIAL
  FAILED
  SKIPPED
}

enum FindingChangeType {
  NEW
  RESOLVED
  PERSISTING
  REGRESSED
  UNCHANGED
}

enum AlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
  SUPPRESSED
}

model User {
  id                      String                   @id @default(uuid())
  email                   String                   @unique
  passwordHash            String
  emailVerifiedAt         DateTime?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  memberships             OrganizationMember[]
  sessions                Session[]
  accounts                Account[]
  securityEvents          SecurityEvent[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
}

model Account {
  id                String @id @default(uuid())
  userId            String
  provider          String
  providerAccountId String
  user              User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id                  String    @id @default(uuid())
  userId              String
  refreshTokenHash    String    @unique
  replacedByTokenHash String?
  expiresAt           DateTime
  revokedAt           DateTime?
  lastSeenAt          DateTime  @default(now())
  ipAddress           String?
  userAgent           String?
  createdAt           DateTime  @default(now())
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([userId, expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model SecurityEvent {
  id        String   @id @default(uuid())
  userId    String?
  type      String
  ipAddress String?
  metadata  Json?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([type, createdAt])
}

model Organization {
  id                String              @id @default(uuid())
  name              String
  slug              String              @unique
  deletedAt         DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  members           OrganizationMember[]
  websites          Website[]
  audits            Audit[]
  subscriptions     Subscription[]
  payments          Payment[]
  invoices          Invoice[]
  billingEvents     BillingEvent[]
  usageRecords      UsageRecord[]
  apiKeys           ApiKey[]
  webhooks          WebhookEndpoint[]
  reports           Report[]
  monitoringConfigs MonitoringConfig[]
  monitoringRuns    MonitoringRun[]
  monitoringAlerts  MonitoringAlert[]
  testimonials      Testimonial[]
}

model OrganizationMember {
  organizationId String
  userId         String
  role           Role
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([organizationId, userId])
  @@index([userId])
}

model Website {
  id               String            @id @default(uuid())
  organizationId   String
  url              String
  normalizedUrl    String
  domain           String
  name             String
  status           String            @default("ACTIVE")
  deletedAt        DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  domains          WebsiteDomain[]
  settings         WebsiteSettings?
  audits           Audit[]
  monitoringConfig MonitoringConfig?

  @@unique([organizationId, url])
  @@index([organizationId, deletedAt])
}

model WebsiteDomain {
  id         String    @id @default(uuid())
  websiteId  String
  hostname   String
  verifiedAt DateTime?
  website    Website   @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@unique([websiteId, hostname])
}

model WebsiteSettings {
  websiteId String  @id
  settings  Json
  website   Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)
}

model Audit {
  id                String         @id @default(uuid())
  organizationId    String
  websiteId         String
  status            AuditStatus    @default(QUEUED)
  progress          Int            @default(0)
  progressStage     String         @default("queued")
  idempotencyKey    String?
  scoringVersion    String         @default("v3")
  queuedAt          DateTime       @default(now())
  startedAt         DateTime?
  completedAt       DateTime?
  durationMs        Int?
  pagesDiscovered   Int            @default(0)
  pagesFetched      Int            @default(0)
  pagesScanned      Int            @default(0)
  findingsGenerated Int            @default(0)
  businessImpact    Json?
  executiveSummary  Json?
  telemetry         Json?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  organization      Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  website           Website        @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  runs              AuditRun[]
  pages             AuditPage[]
  findings          AuditFinding[]
  score             AuditScore?
  reports           Report[]

  @@index([organizationId, createdAt])
  @@index([websiteId, status])
  @@unique([organizationId, idempotencyKey])
}

model AuditPage {
  id             String   @id @default(uuid())
  auditId        String
  url            String
  finalUrl       String
  statusCode     Int?
  title          String?
  contentType    String?
  headers        Json?
  htmlAvailable  Boolean  @default(false)
  responseTimeMs Int?
  depth          Int
  parentUrl      String?
  errorCode      String?
  redirectChain  Json?
  createdAt      DateTime @default(now())
  audit          Audit    @relation(fields: [auditId], references: [id], onDelete: Cascade)

  @@unique([auditId, url])
  @@index([auditId, depth])
}

model AuditRun {
  id            String      @id @default(uuid())
  auditId       String
  status        AuditStatus @default(QUEUED)
  pagesFetched  Int         @default(0)
  findingsCount Int         @default(0)
  durationMs    Int?
  errorCode     String?
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime    @default(now())
  audit         Audit       @relation(fields: [auditId], references: [id], onDelete: Cascade)

  @@index([auditId, createdAt])
}

model AuditFinding {
  id                 String       @id @default(uuid())
  auditId            String
  ruleId             String
  internalKey        String?
  normalizedIssueKey String?
  category           String
  scope              FindingScope @default(PAGE)
  severity           Severity
  title              String
  description        String
  evidence           Json
  affectedUrl        String?
  recommendation     String
  scoreImpact        Int
  businessImpact     String?
  metadata           Json?
  audit              Audit        @relation(fields: [auditId], references: [id], onDelete: Cascade)

  @@index([auditId, severity])
  @@index([auditId, scope])
  @@index([auditId, category])
  @@index([auditId, normalizedIssueKey])
}

model AuditScore {
  auditId     String @id
  lead        Int
  advertising Int
  seo         Int
  security    Int
  overall     Int
  audit       Audit  @relation(fields: [auditId], references: [id], onDelete: Cascade)
}

model Report {
  id             String            @id @default(uuid())
  organizationId String
  auditId        String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  audit          Audit             @relation(fields: [auditId], references: [id])
  versions       ReportVersion[]
  shareLinks     ReportShareLink[]
}

model ReportVersion {
  id       String @id @default(uuid())
  reportId String
  version  Int
  content  Json
  report   Report @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@unique([reportId, version])
}

model ReportShareLink {
  id        String    @id @default(uuid())
  reportId  String
  tokenHash String    @unique
  expiresAt DateTime?
  revokedAt DateTime?
  report    Report    @relation(fields: [reportId], references: [id], onDelete: Cascade)
}

model MonitoringConfig {
  id                      String              @id @default(uuid())
  organizationId          String
  websiteId               String              @unique
  enabled                 Boolean             @default(true)
  frequency               MonitoringFrequency @default(HOURLY)
  maxPages                Int                 @default(10)
  maxDepth                Int                 @default(2)
  consecutiveFailures     Int                 @default(0)
  failureThreshold        Int                 @default(2)
  responseTimeThresholdMs Int                 @default(3000)
  tlsExpiryThresholdDays  Int                 @default(14)
  lockedUntil             DateTime?
  healthChecks            Json?
  alertPolicy             Json?
  baseline                Json?
  lastRunAt               DateTime?
  nextRunAt               DateTime?
  archivedAt              DateTime?
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt
  organization            Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  website                 Website             @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  runs                    MonitoringRun[]
  findings                MonitoringFinding[]
  alerts                  MonitoringAlert[]

  @@index([organizationId, enabled, archivedAt])
  @@index([enabled, nextRunAt])
}

model MonitoringRun {
  id                  String            @id @default(uuid())
  monitoringConfigId  String
  websiteId           String
  organizationId      String
  scheduledSlot       String?
  idempotencyKey      String?
  status              MonitoringStatus  @default(QUEUED)
  httpStatus          Int?
  responseTimeMs      Int?
  tlsValid            Boolean?
  tlsExpiresAt        DateTime?
  redirectChain       Json?
  scores              Json?
  scoreDeltas         Json?
  pagesEvaluated      Int               @default(1)
  findingsCount       Int               @default(0)
  newRegressionsCount Int               @default(0)
  resolvedCount       Int               @default(0)
  telemetry           Json?
  errorCode           String?
  scheduledAt         DateTime?
  startedAt           DateTime?
  completedAt         DateTime?
  durationMs          Int?
  createdAt           DateTime          @default(now())
  config              MonitoringConfig  @relation(fields: [monitoringConfigId], references: [id], onDelete: Cascade)
  organization        Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  findings            MonitoringFinding[]
  alerts              MonitoringAlert[]

  @@unique([monitoringConfigId, scheduledSlot])
  @@index([monitoringConfigId, createdAt])
  @@index([organizationId, createdAt])
}

model MonitoringFinding {
  id                 String            @id @default(uuid())
  monitoringRunId    String
  monitoringConfigId String
  websiteId          String
  organizationId     String
  ruleId             String
  category           String
  severity           Severity
  changeType         FindingChangeType
  title              String
  description        String
  affectedUrl        String?
  pageTitle          String?
  beforeState        Json?
  afterState         Json?
  evidence           Json?
  detectedAt         DateTime          @default(now())
  run                MonitoringRun     @relation(fields: [monitoringRunId], references: [id], onDelete: Cascade)
  config             MonitoringConfig  @relation(fields: [monitoringConfigId], references: [id], onDelete: Cascade)

  @@index([monitoringConfigId, detectedAt])
  @@index([monitoringConfigId, affectedUrl])
  @@index([monitoringRunId, changeType])
}

model MonitoringAlert {
  id                 String            @id @default(uuid())
  organizationId     String
  monitoringConfigId String?
  monitoringRunId    String?
  websiteId          String?
  fingerprint        String
  ruleId             String?
  severity           Severity          @default(HIGH)
  title              String
  message            String
  status             AlertStatus       @default(OPEN)
  lastAlertedAt      DateTime          @default(now())
  cooldownUntil      DateTime?
  acknowledgedAt     DateTime?
  resolvedAt         DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  organization       Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  config             MonitoringConfig? @relation(fields: [monitoringConfigId], references: [id], onDelete: Cascade)
  run                MonitoringRun?    @relation(fields: [monitoringRunId], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([monitoringConfigId, fingerprint])
}

model Plan {
  id              String          @id @default(uuid())
  code            String          @unique
  name            String
  description     String?
  priceInPaise    Int             @default(0)
  currency        String          @default("INR")
  billingInterval BillingInterval @default(MONTHLY)
  entitlements    Json
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  subscriptions   Subscription[]
}

model Subscription {
  id                     String             @id @default(uuid())
  organizationId         String
  planId                 String
  status                 SubscriptionStatus @default(ACTIVE)
  provider               String             @default("RAZORPAY")
  providerSubscriptionId String?            @unique
  providerCustomerId     String?
  currentPeriodStart     DateTime           @default(now())
  currentPeriodEnd       DateTime?
  cancelAtPeriodEnd      Boolean            @default(false)
  canceledAt             DateTime?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  organization           Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan                   Plan               @relation(fields: [planId], references: [id])
  payments               Payment[]

  @@index([organizationId, status])
}

model Payment {
  id                String         @id @default(uuid())
  organizationId    String
  subscriptionId    String?
  provider          String         @default("RAZORPAY")
  providerPaymentId String         @unique
  providerOrderId   String?
  providerSignature String?
  amountInPaise     Int
  currency          String         @default("INR")
  status            PaymentStatus  @default(CAPTURED)
  purpose           PaymentPurpose @default(SUBSCRIPTION)
  metadata          Json?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  organization      Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subscription      Subscription?  @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  invoices          Invoice[]

  @@index([organizationId, createdAt])
}

model Invoice {
  id             String        @id @default(uuid())
  organizationId String
  paymentId      String?
  invoiceNumber  String        @unique
  amountInPaise  Int
  currency       String        @default("INR")
  status         InvoiceStatus @default(PAID)
  billingAddress Json?
  taxInfo        Json?
  pdfUrl         String?
  paidAt         DateTime?
  createdAt      DateTime      @default(now())
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  payment        Payment?      @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
}

model BillingEvent {
  id              String       @id @default(uuid())
  organizationId  String
  provider        String       @default("RAZORPAY")
  providerEventId String?
  type            String
  data            Json?
  createdAt       DateTime     @default(now())
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
}

model UsageRecord {
  id             String       @id @default(uuid())
  organizationId String
  period         String
  metric         UsageMetric
  count          Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, period, metric])
  @@index([organizationId, period])
}

model ApiKey {
  id             String       @id @default(uuid())
  organizationId String
  name           String
  keyPrefix      String?
  keyHash        String       @unique
  scopes         String[]
  expiresAt      DateTime?
  lastUsedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, revokedAt])
}

model WebhookEndpoint {
  id             String       @id @default(uuid())
  organizationId String
  url            String
  secretHash     String
  events         String[]
  enabled        Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, enabled])
}

model Testimonial {
  id             String       @id @default(uuid())
  organizationId String
  quote          String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}
